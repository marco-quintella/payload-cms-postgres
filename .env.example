# Copie pra .env e ajuste antes do primeiro deploy
# (no Railway, essas vars são configuradas no wizard do template)

# Postgres — URL de conexão (obrigatória)
DATABASE_URL=postgresql://postgres:***@host:5432/payload

# Secret do Payload — gere um valor aleatório (min. 32 chars)
PAYLOAD_SECRET=generate-a-random-32-char-secret
